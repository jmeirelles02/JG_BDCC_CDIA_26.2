option_settings:
  aws:elasticbeanstalk:container:python:
    WSGIPath: lavouraInteligente_JG.wsgi:application
  aws:elasticbeanstalk:application:environment:
    DJANGO_SETTINGS_MODULE: lavouraInteligente_JG.settings
    DJANGO_DEBUG: "False"
  aws:elasticbeanstalk:environment:
    EnvironmentType: SingleInstance
  aws:elasticbeanstalk:environment:proxy:staticfiles:
    /static: staticfiles
container_commands:
  00_django_secret:
    command: |
      set -e
      . /var/app/venv/*/bin/activate
      install -d -m 700 -o webapp -g webapp /var/app/django-secrets
      python - <<'PY'
      import os
      import secrets
      from pathlib import Path
      path = Path("/var/app/django-secrets/secret-key")
      if not path.exists():
          descriptor = os.open(path, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600)
          with os.fdopen(descriptor, "w") as output:
              output.write(secrets.token_urlsafe(64))
      PY
      chown webapp:webapp /var/app/django-secrets/secret-key
      chmod 600 /var/app/django-secrets/secret-key
  01_migrate:
    command: ". /var/app/venv/*/bin/activate && DJANGO_DEBUG=False python manage.py migrate --noinput"
  02_bootstrap_admin:
    command: ". /var/app/venv/*/bin/activate && DJANGO_DEBUG=False python manage.py bootstrap_admin"
  03_collectstatic:
    command: ". /var/app/venv/*/bin/activate && DJANGO_DEBUG=False python manage.py collectstatic --noinput"
  04_sqlite_permissions:
    command: "chown webapp:webapp . db.sqlite3 && chmod 755 . && chmod 600 db.sqlite3"
